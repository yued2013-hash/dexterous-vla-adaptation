+    def _relative_pose_affine(self, kind: str, reference: Tensor) -> tuple[Tensor, Tensor]:
+        mode = self._relative_pose_normalization_mode()
+        if mode == "mean_std":
+            mean = self._relative_pose_stat(f"relative_pose_{kind}_mean", reference)
+            std = self._relative_pose_stat(f"relative_pose_{kind}_std", reference)
+            return std.reciprocal(), -mean / std
+        if mode != "limits":
+            raise RuntimeError(f"Unsupported relative-pose normalization mode: {mode!r}.")
+
+        minimum = self._relative_pose_stat(f"relative_pose_{kind}_min", reference)
+        maximum = self._relative_pose_stat(f"relative_pose_{kind}_max", reference)
+        input_range = maximum - minimum
+        range_eps = getattr(self.config, "relative_pose_normalization_range_eps", 1e-4)
+        constant = input_range < range_eps
+        safe_range = torch.where(constant, torch.full_like(input_range, 2.0), input_range)
+        scale = 2.0 / safe_range
+        offset = -1.0 - scale * minimum
+        # Exact JC LinearNormalizer behavior: constant dimensions use unit
+        # scale and map the observed constant to the midpoint (zero).
+        offset = torch.where(constant, -minimum, offset)
+        return scale, offset
