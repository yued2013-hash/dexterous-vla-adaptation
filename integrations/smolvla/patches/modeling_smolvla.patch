+def _ddp_global_mean_from_local_sum(local_sum: Tensor, local_count: Tensor) -> Tensor:
+    """Return a loss whose DDP-averaged gradient is the exact global mean.
+
+    DDP averages gradients uniformly across ranks. When padding makes valid
+    element counts differ, averaging rank-local means is biased. We therefore
+    all-reduce only the detached denominator and scale each rank's differentiable
+    numerator by ``world_size / global_count``. After DDP's gradient average,
+    the result is exactly ``sum(local_numerator) / sum(local_count)``.
+    """
+    if local_sum.ndim != 0 or local_count.ndim != 0:
+        raise ValueError("Distributed mean expects scalar numerator and count tensors.")
+
+    world_size = 1
+    global_count = local_count.detach().to(dtype=torch.float64).clone()
+    if torch.distributed.is_available() and torch.distributed.is_initialized():
+        torch.distributed.all_reduce(global_count, op=torch.distributed.ReduceOp.SUM)
+        world_size = torch.distributed.get_world_size()
+    denominator = global_count.clamp_min(1).to(dtype=local_sum.dtype)
+    return local_sum * world_size / denominator
 
 
