+def get_process_rng_state_dir(checkpoint_dir: Path, process_index: int) -> Path:
+    """Return the checkpoint directory reserved for one distributed process's RNG state."""
+    if process_index < 0:
+        raise ValueError(f"process_index must be non-negative, got {process_index}")
+    return checkpoint_dir / TRAINING_STATE_DIR / _PROCESS_RNG_STATES_DIR / f"rank_{process_index:05d}"
+
+
+def save_process_rng_state(checkpoint_dir: Path, process_index: int) -> Path:
+    """Save one process's Python, NumPy, CPU torch, and current-device CUDA RNG states.
+
+    Distributed callers must invoke this once on every process. Each process writes a unique file,
+    so no collective or rank-0 gathering is required.
+    """
+    rng_state_dir = get_process_rng_state_dir(checkpoint_dir, process_index)
+    rng_state_dir.mkdir(parents=True, exist_ok=True)
+    save_rng_state(rng_state_dir)
+    return rng_state_dir
+
+
+def resolve_process_rng_state_dir(checkpoint_dir: Path, process_index: int) -> Path:
+    """Select a process-specific RNG state, falling back to the legacy rank-0 state.
+
+    Older checkpoints contain only ``training_state/rng_state.safetensors``. Keeping this fallback
+    preserves their loadability, although exact DDP continuation requires a checkpoint written with
+    one RNG state per process.
+    """
+    process_dir = get_process_rng_state_dir(checkpoint_dir, process_index)
+    if (process_dir / RNG_STATE).is_file():
+        return process_dir
+
+    legacy_dir = checkpoint_dir / TRAINING_STATE_DIR
+    if not (legacy_dir / RNG_STATE).is_file():
+        raise FileNotFoundError(legacy_dir / RNG_STATE)
+    return legacy_dir
 
 
