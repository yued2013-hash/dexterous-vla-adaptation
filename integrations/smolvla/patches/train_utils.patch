+def should_restore_rng_before_dataloader(sampler_state: dict | None, *, persistent_workers: bool) -> bool:
+    """Whether resume RNG must be restored before constructing the next DataLoader iterator.
+
+    At an epoch boundary, an uninterrupted run creates a new iterator after the checkpoint and
+    legitimately consumes its worker-base-seed draw. Mid-epoch, recreating an iterator is a resume
+    artifact, so its RNG consumption must instead be erased by restoring immediately before the
+    first stochastic forward pass.
+    """
+    return sampler_state is not None and sampler_state["start_index"] == 0 and not persistent_workers
 
 
